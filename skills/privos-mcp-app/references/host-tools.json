    {
      "hook": "useLists",
      "hostTool": "privos.lists.getAll",
      "scope": "lists:read"
    },
    {
      "hook": "useRoom",
      "hostTool": "privos.rooms.get",
      "scope": "rooms:read"
    },
    {
      "hook": "useFiles",
      "hostTool": "privos.files.getAll",
      "scope": null,
      "broken": true,
      "note": "privos.files.getAll does not exist on the Hub, so useFiles always fails. Use usePrivosTool('privos.files.getByChannel', { ... }) and declare files:read."
